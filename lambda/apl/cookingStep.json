{
  "type": "APL",
  "version": "2023.3",
  "theme": "light",
  "import": [
    { "name": "alexa-layouts", "version": "1.7.0" }
  ],
  "mainTemplate": {
    "parameters": ["payload"],
    "items": [
      {
        "type": "Container",
        "width": "100vw",
        "height": "100vh",
        "backgroundColor": "#FAF7F0",
        "direction": "column",
        "items": [
          {
            "type": "Container",
            "width": "100%",
            "paddingLeft": "6vw",
            "paddingRight": "6vw",
            "paddingTop": "4vh",
            "direction": "row",
            "alignItems": "center",
            "justifyContent": "spaceBetween",
            "items": [
              {
                "type": "Text",
                "text": "${payload.cooking.title}",
                "fontSize": "34dp",
                "fontWeight": "700",
                "color": "#7A5C2E",
                "maxLines": 1
              },
              {
                "type": "Text",
                "text": "Schritt ${payload.cooking.stepNumber} von ${payload.cooking.totalSteps}",
                "fontSize": "24dp",
                "fontWeight": "500",
                "color": "#9A8A6B"
              }
            ]
          },
          {
            "type": "Container",
            "grow": 1,
            "width": "100%",
            "paddingLeft": "8vw",
            "paddingRight": "8vw",
            "justifyContent": "center",
            "items": [
              {
                "type": "Text",
                "text": "${payload.cooking.stepText}",
                "fontSize": "44dp",
                "lineHeight": 1.25,
                "color": "#2B2B2B",
                "textAlign": "left"
              }
            ]
          },
          {
            "type": "Container",
            "width": "100%",
            "direction": "row",
            "paddingLeft": "6vw",
            "paddingRight": "6vw",
            "paddingBottom": "5vh",
            "justifyContent": "spaceBetween",
            "alignItems": "center",
            "items": [
              {
                "type": "TouchWrapper",
                "disabled": "${payload.cooking.stepNumber == 1}",
                "opacity": "${payload.cooking.stepNumber == 1 ? 0.3 : 1}",
                "onPress": {
                  "type": "SendEvent",
                  "arguments": ["previous"]
                },
                "item": {
                  "type": "Frame",
                  "backgroundColor": "#E8DFC9",
                  "borderRadius": "40dp",
                  "paddingTop": "18dp",
                  "paddingBottom": "18dp",
                  "paddingLeft": "44dp",
                  "paddingRight": "44dp",
                  "item": {
                    "type": "Text",
                    "text": "‹ Zurück",
                    "fontSize": "28dp",
                    "fontWeight": "600",
                    "color": "#7A5C2E"
                  }
                }
              },
              {
                "type": "TouchWrapper",
                "onPress": {
                  "type": "SendEvent",
                  "arguments": ["next"]
                },
                "item": {
                  "type": "Frame",
                  "backgroundColor": "#C9A227",
                  "borderRadius": "40dp",
                  "paddingTop": "18dp",
                  "paddingBottom": "18dp",
                  "paddingLeft": "48dp",
                  "paddingRight": "48dp",
                  "item": {
                    "type": "Text",
                    "text": "${payload.cooking.isLast ? 'Fertig ✓' : 'Weiter ›'}",
                    "fontSize": "28dp",
                    "fontWeight": "700",
                    "color": "#FFFFFF"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
